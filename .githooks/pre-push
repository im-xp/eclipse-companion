#!/usr/bin/env bash
# Advisory pre-push: warn when architecture-relevant code changes but
# src/docs/ARCHITECTURE.md wasn't updated in the same push. Non-blocking —
# it's a reminder, never a gate. Enable once per clone with:
#   git config core.hooksPath .githooks
set -u

DOC="src/docs/ARCHITECTURE.md"
# File paths whose behavior the architecture doc describes. Keep in sync with
# the doc's sections (auth, favorites, schedule pipeline, email, deploy).
PATTERNS='^src/lib/(auth|favorites|profile|schedule|email)|^src/app/api/(auth|profile)/|^src/scripts/normalize_schedule|^scripts/sync_schedule|^src/proxy\.ts'
ZERO="0000000000000000000000000000000000000000"

flagged=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue   # branch deletion
  if [ "$remote_sha" = "$ZERO" ]; then     # new branch: diff vs origin/main
    base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
    files="$([ -n "$base" ] && git diff --name-only "$base" "$local_sha" \
              || git show --name-only --pretty=format: "$local_sha")"
  else
    files="$(git diff --name-only "$remote_sha" "$local_sha")"
  fi
  echo "$files" | grep -qE "$PATTERNS" || continue   # no arch-domain change
  echo "$files" | grep -qx "$DOC" && continue        # doc updated too — fine
  flagged=1
done

if [ "$flagged" = "1" ]; then
  cat >&2 <<'EOF'

  ⚠  Architecture-relevant files changed, but src/docs/ARCHITECTURE.md was not.
     If auth / favorites / schedule / email / deploy behavior changed, please
     update the doc (it's auto-loaded into agent context each session).
     This is a reminder — the push continues.

EOF
fi
exit 0
