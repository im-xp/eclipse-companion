# Copy to .sync.env to enable the schedule auto-sync (scripts/sync_schedule.sh).
#
# SHEET_ID = the Google Sheet ID of Elliot's ROS sheet (the one with the
# "ROS Chart (auto)" tab that normalize_schedule.py reads). Find it in the
# sheet URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
#
# REQUIRED FIRST: the sheet owner must set sharing to
#   "Anyone with the link → Viewer"
# so the cron can fetch the xlsx export without credentials.
SHEET_ID=

# Optional: 1 = post a note to #imxp-simplefi each time a change goes live.
SLACK_NOTIFY=0
