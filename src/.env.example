# Login mode: demo | list | live | magic
#   demo  — any email signs in, sees the bundled sample profile (no API)
#   list  — any listed email signs straight into their REAL profile, no code
#           (auth bypass: gated-staging only, requires STAGING_PASSWORD)
#   live  — EdgeOS emails a 6-digit code the participant must submit
#   magic — we email a single-use sign-in link via SES (public launch mode)
AUTH_MODE=demo

# Participation API (needed for list + live + magic)
PAT_API_BASE=https://0wsgxxrcq6.execute-api.us-east-1.amazonaws.com
PAT_API_TOKEN=

# Signs the session cookie AND magic login tokens. Required in production.
SESSION_SECRET=

# Magic-link mode (AUTH_MODE=magic): Postmark sender + link origin.
#   POSTMARK_SERVER_TOKEN — server API token (the IMXP "Iceland And Egypt"
#     Postmark server, same token portal-dashboard uses). Required for magic.
#   POSTMARK_FROM_EMAIL   — verified sender; defaults to
#     "Iceland Eclipse <noreply@icelandeclipse.com>" (a confirmed sender).
#   POSTMARK_TEMPLATE_ALIAS — defaults to iceland-eclipse-signin (model:
#     the_url = magic link, popup_name = event label).
#   POSTMARK_MESSAGE_STREAM — defaults to "outbound" (transactional).
#   APP_BASE_URL — public origin used to build the emailed link; set it in
#     production (e.g. https://app.icelandeclipse.com) so links don't point at
#     the *.vercel.app deployment URL. Falls back to the request origin if unset.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
POSTMARK_TEMPLATE_ALIAS=iceland-eclipse-signin
POSTMARK_MESSAGE_STREAM=outbound
APP_BASE_URL=

# Staging password gate (HTTP Basic Auth over the whole site). Set on Preview
# deployments; LEAVE UNSET on Production. Username is ignored.
STAGING_PASSWORD=
