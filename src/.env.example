# Login mode: demo | list | live
#   demo — any email signs in, sees the bundled sample profile (no API)
#   list — any listed email signs straight into their REAL profile, no code
#          (auth bypass: gated-staging only, requires STAGING_PASSWORD)
#   live — EdgeOS emails a 6-digit code the participant must submit
AUTH_MODE=demo

# Participation API (needed for list + live)
PAT_API_BASE=https://0wsgxxrcq6.execute-api.us-east-1.amazonaws.com
PAT_API_TOKEN=

# Signs the session cookie. Required in production; any value in dev.
SESSION_SECRET=

# Staging password gate (HTTP Basic Auth over the whole site). Set on Preview
# deployments; LEAVE UNSET on Production. Username is ignored.
STAGING_PASSWORD=
